# Neon pooled connection string (neon deploy writes the real value to .env.local)
DATABASE_URL=postgres://user:password@host/neondb?sslmode=require
# Optional: direct (non-pooled) URL used for migrations
DATABASE_URL_UNPOOLED=
# 32+ random chars: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# "production" only on the live domain (robots.txt allows crawling)
SITE_ENV=development
# Set to 1 only behind a trusted proxy that sets X-Forwarded-For (e.g. Vercel)
TRUST_PROXY=0
